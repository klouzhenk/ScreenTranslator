<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        x:Class="ScreenTranslator.Translation.ResultWindow"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI"
        Foreground="White">
    <Border x:Name="OuterBorder"
            Background="#F0202020"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="Black" Opacity="0.55" />
        </Border.Effect>
        <StackPanel Margin="20,16" MaxWidth="520">
            <TextBlock x:Name="OriginalText"
                       TextWrapping="Wrap"
                       Opacity="0.65"
                       LineHeight="22" />
            <Border x:Name="Divider"
                    Height="1"
                    Background="#30FFFFFF"
                    Margin="0,12" />
            <TextBlock x:Name="TranslatedText"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       LineHeight="24" />
        </StackPanel>
    </Border>
</Window>
