<Application x:Class="ScreenTranslator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             xmlns:local="clr-namespace:ScreenTranslator"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="ScreenTranslator">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="ST"
                                        Foreground="White"
                                        Background="#1E3A8A"
                                        FontSize="22"/>
            </tb:TaskbarIcon.IconSource>

            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Налаштування" Click="OnSettingsClick"/>
                    <Separator />
                    <MenuItem Header="Закрити" Click="OnShutdownClick"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
