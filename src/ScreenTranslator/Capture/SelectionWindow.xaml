<Window x:Class="ScreenTranslator.Capture.SelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black"
        Cursor="Cross">
    <Grid>
        <Image x:Name="FrameImage" Stretch="Fill" />
		<Canvas x:Name="OverlayCanvas">
			<Rectangle x:Name="SelectionRectangle"
					   Stroke="#FF4FC3F7"
					   StrokeThickness="2"
					   Fill="#334FC3F7"
					   Visibility="Collapsed"/>
		</Canvas>
    </Grid>
</Window>
